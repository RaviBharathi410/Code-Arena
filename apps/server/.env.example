# CodeArena Main Server Environment Configuration

# Database (MongoDB Connection String)
DATABASE_URL=mongodb://username:password@localhost:27017/codearena?authSource=admin

# Cache & Message Broker (Redis Connection String)
REDIS_URL=redis://127.0.0.1:6379

# Authentication Secrets (minimum 32 characters)
JWT_SECRET=replace_with_secure_random_jwt_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_secure_random_refresh_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Server Port & Allowed CORS Origins
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Isolate Execution Engine Service (Port 3005)
EXECUTION_ENGINE_URL=http://localhost:3005
EXECUTION_ENGINE_TOKEN=replace_with_secure_random_executor_shared_token_in_production

# Judge0 API (Optional Fallback / Legacy Integration)
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=your_judge0_api_key_here
USE_JUDGE0_MOCK=false

# AI Providers Configuration (Gemini, Groq, OpenRouter, Cerebras)
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=

